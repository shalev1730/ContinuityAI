        <script><![CDATA[(function normalizeWeekStart(current) {
    var weekStart = current.getValue('week_start');
    if (!weekStart) return;

    var gdt = new GlideDateTime(weekStart + ' 00:00:00');
    var dayOfWeek = gdt.getDayOfWeekLocalTime();
    // ServiceNow: 1=Mon, 2=Tue, ..., 6=Sat, 7=Sun
    var daysToSubtract = dayOfWeek % 7; // 7(Sun)->0, 1(Mon)->1, ..., 6(Sat)->6
    if (daysToSubtract > 0) {
        gdt.addDaysLocalTime(-daysToSubtract);
        current.setValue('week_start', gdt.getDate().getByFormat('yyyy-MM-dd'));
    }
})(current);
]]></script>
