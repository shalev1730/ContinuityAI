        <script><![CDATA[(function preventDuplicateEmployee(current) {
    var employeeVal = current.getValue('employee');
    if (!employeeVal) return;

    var gr = new GlideRecord('x_2316178_contin_0_emp_profile');
    gr.addQuery('employee', employeeVal);
    gr.addQuery('sys_id', '!=', current.getUniqueValue());
    gr.query();
    if (gr.next()) {
        gs.addErrorMessage('An Employee Profile already exists for this employee. Each employee can have only one profile.');
        current.setAbortAction(true);
    }
})(current);
]]></script>
