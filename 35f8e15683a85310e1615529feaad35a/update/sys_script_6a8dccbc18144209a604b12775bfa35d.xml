        <script><![CDATA[(function(current, previous) {
    var newState = current.getValue('decision_state');
    var oldState = previous ? previous.getValue('decision_state') : '';

    if (newState == 'approved' && oldState != 'approved') {
        var authSvc = new x_2316178_contin_0.AuthorizationService();
        var result = authSvc.canApproveItem(current.getUniqueValue(), gs.getUserID());

        if (!result.authorized) {
            authSvc.logDenial('approve_item', gs.getUserID(), result.reason);
            gs.addErrorMessage('You are not authorized to approve this item: ' + result.reason);
            current.setAbortAction(true);
        }
    }
})(current, previous);
]]></script>
