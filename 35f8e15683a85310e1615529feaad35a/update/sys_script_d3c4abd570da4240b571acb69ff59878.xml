        <script><![CDATA[(function(current, previous) {
    // Allow controlled transition from pending to completed/failed
    var oldOutcome = previous ? previous.getValue('outcome') : '';
    var newOutcome = current.getValue('outcome');

    if (oldOutcome == 'pending' && (newOutcome == 'completed' || newOutcome == 'failed')) {
        // Allowed transition: only outcome and error_detail can change
        return;
    }

    // Block all other updates
    gs.addErrorMessage('Action Log records are append-only and cannot be modified after creation. Only pending-to-completed/failed transitions are allowed.');
    current.setAbortAction(true);
})(current, previous);
]]></script>
