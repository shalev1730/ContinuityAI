        <script><![CDATA[function onSubmit() {
    var startDate = g_form.getValue('absence_start');
    var endDate = g_form.getValue('absence_end');

    if (!startDate || !endDate) {
        return true; // Let mandatory validation handle empty fields
    }

    if (startDate > endDate) {
        g_form.addErrorMessage('Absence Start Date must be on or before Absence End Date.');
        return false;
    }

    return true;
}
