        <script><![CDATA[(function createResourcePlan(current) {
    // Idempotent: check if RP already exists
    var existingRP = new GlideRecord('x_2316178_contin_0_res_plan');
    existingRP.addQuery('project_task', current.getUniqueValue());
    existingRP.query();
    if (existingRP.next()) {
        return; // RP already exists, do not create duplicate
    }

    var rp = new GlideRecord('x_2316178_contin_0_res_plan');
    rp.initialize();
    rp.setValue('project_task', current.getUniqueValue());
    rp.setValue('assignment_group', current.getValue('assignment_group'));
    rp.setValue('start_date', current.getValue('planned_start'));
    rp.setValue('end_date', current.getValue('planned_end'));
    rp.insert();
})(current);
]]></script>
